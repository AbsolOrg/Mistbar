#!/usr/bin/env bash
# ============================================================================
# Mistbar — macOS Tahoe Liquid Glass Top Bar for Linux (Wayland)
# CLI launcher and manager
# ============================================================================

set -euo pipefail

SCRIPT_SOURCE="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"
SRC_DIR="$SCRIPT_DIR/src"
INSTANCE_NAME="mistbar"
CONFIG_DIR="$HOME/.config/mistbar"
CONFIG_FILE="$CONFIG_DIR/config.json"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m' # No Color

print_banner() {
    echo -e "${CYAN}${BOLD}"
    echo "  ========================================"
    echo "              Mistbar v0.2.0              "
    echo "       macOS Tahoe Liquid Glass Bar       "
    echo "  ========================================"
    echo -e "${NC}"
}

print_help() {
    print_banner
    echo -e "${BOLD}USAGE:${NC}"
    echo "    mistbar <command> [options]"
    echo ""
    echo -e "${BOLD}COMMANDS:${NC}"
    echo -e "    ${GREEN}start${NC}                            Start the bar"
    echo -e "    ${GREEN}stop${NC}                             Stop the bar"
    echo -e "    ${GREEN}restart${NC}                          Restart the bar"
    echo -e "    ${GREEN}toggle${NC}                           Toggle intelligent auto-hide on/off"
    echo -e "    ${GREEN}show${NC}                             Show the bar (always visible)"
    echo -e "    ${GREEN}hide${NC}                             Hide the bar completely (disables cursor hovers)"
    echo -e "    ${GREEN}auto-hide <on|off|toggle>${NC}        Intelligent auto-hide (or --auto-hide)"
    echo -e "    ${GREEN}theme <dark|light>${NC}               Switch theme dynamically"
    echo -e "    ${GREEN}style <glassy [dark|white]|transparent|solid>${NC} Switch background style"
    echo -e "    ${GREEN}look <pill|attached>${NC}             Switch shape/geometry dynamically"
    echo -e "    ${GREEN}status${NC}                           Check if the bar is running"
    echo -e "    ${GREEN}config${NC}                           View or edit configuration"
    echo -e "    ${GREEN}update${NC}                           Update Mistbar to latest release or main"
    echo -e "    ${GREEN}uninstall${NC}                        Uninstall Mistbar from your system"
    echo -e "    ${GREEN}inspect${NC}                          Open GTK Inspector for live debugging"
    echo -e "    ${GREEN}install-deps${NC}                     Install required system dependencies"
    echo ""
    echo -e "${BOLD}OPTIONS / SHORTCUTS:${NC}"
    echo -e "    ${BLUE}--auto-hide${NC}                      Enable intelligent auto-hide"
    echo -e "    ${BLUE}--always-visible${NC}                 Disable auto-hide (always visible)"
    echo -e "    ${BLUE}-h, --help${NC}                       Show this help message"
    echo -e "    ${BLUE}-v, --version${NC}                    Show version"
    echo ""
    echo -e "${BOLD}EXAMPLES:${NC}"
    echo "    mistbar start"
    echo "    mistbar auto-hide on       # Intelligent auto-hide (slides away over windows, reveals on top hover)"
    echo "    mistbar auto-hide off      # Always visible"
    echo "    mistbar auto-hide toggle   # Toggle intelligent auto-hide"
    echo "    mistbar toggle             # Toggle intelligent auto-hide"
    echo "    mistbar hide               # Force-hide bar completely (disables cursor hovers)"
    echo "    mistbar show               # Show bar (always visible)"
    echo "    mistbar style glassy       # Frosted liquid glass (default text)"
    echo "    mistbar style glassy dark  # Frosted liquid glass with dark fonts & logos"
    echo "    mistbar style glassy white # Frosted liquid glass with white fonts & logos"
    echo "    mistbar style transparent  # 100% clear see-through background"
    echo "    mistbar style solid        # Solid opaque color (pitch black/white)"
    echo "    mistbar look pill          # Floating rounded pill (default)"
    echo "    mistbar look attached      # Edge-to-edge full-width top bar"
    echo "    mistbar theme light        # Light frosted glass"
    echo "    mistbar theme dark         # Dark frosted glass"
    echo ""
    echo -e "${DIM}Project: https://github.com/AbsolOrg/Mistbar${NC}"
}

check_deps() {
    local missing=()

    command -v ags &>/dev/null || missing+=("ags (AGS 3)")
    command -v niri &>/dev/null || missing+=("niri")
    command -v fuzzel &>/dev/null || missing+=("fuzzel")
    command -v wpctl &>/dev/null || missing+=("wireplumber (wpctl)")
    command -v brightnessctl &>/dev/null || missing+=("brightnessctl")
    command -v nmcli &>/dev/null || missing+=("networkmanager (nmcli)")
    command -v bluetoothctl &>/dev/null || missing+=("bluez-utils (bluetoothctl)")

    if [ ${#missing[@]} -gt 0 ]; then
        echo -e "${RED}Warning: Missing optional/required dependencies:${NC}"
        for dep in "${missing[@]}"; do
            echo -e "  - ${DIM}$dep${NC}"
        done
        echo -e "${BLUE}Run '${BOLD}mistbar install-deps${NC}${BLUE}' or install them with pacman.${NC}"
        echo ""
    fi
}

update_config_json() {
    local key="$1"
    local val="$2"
    mkdir -p "$CONFIG_DIR"
    python3 -c "
import json, os
path = '$CONFIG_FILE'
data = {
  'theme': 'dark',
  'style': 'glassy',
  'look': 'pill',
  'autoHide': False,
  'barHeight': 28,
  'barMargin': 6,
  'borderRadius': 16,
  'showAppMenu': True,
  'showWorkspaces': True,
  'showTray': True,
  'showBattery': True,
  'showBrightness': True,
  'showVolume': True,
  'showNetwork': True,
  'showBluetooth': True,
  'showControlCenter': True,
  'showSpotlight': True
}
if os.path.exists(path):
    try:
        with open(path, 'r') as f:
            data.update(json.load(f))
    except Exception:
        pass
val = '$val'
if val.lower() == 'true':
    val = True
elif val.lower() == 'false':
    val = False
data['$key'] = val
with open(path, 'w') as f:
    json.dump(data, f, indent=2)
" 2>/dev/null || true
}

cmd_start() {
    check_deps

    if ags list 2>/dev/null | grep -q "$INSTANCE_NAME"; then
        echo -e "${BLUE}Mistbar is already running.${NC}"
        return 0
    fi

    echo -e "${GREEN}Starting Mistbar...${NC}"

    mkdir -p "$CONFIG_DIR"
    local log_file="$CONFIG_DIR/mistbar.log"

    # Launch daemon in background detached from current terminal
    setsid -f ags run -d "$SRC_DIR" >"$log_file" 2>&1

    # Wait up to 3 seconds for instance to register
    local count=0
    while [ $count -lt 15 ]; do
        if ags list 2>/dev/null | grep -q "$INSTANCE_NAME"; then
            echo -e "${GREEN}✓ Mistbar started successfully!${NC}"
            return 0
        fi
        sleep 0.2
        count=$((count + 1))
    done

    echo -e "${RED}Failed to verify Mistbar startup.${NC}"
    if [ -f "$log_file" ] && [ -s "$log_file" ]; then
        echo -e "${RED}Error details:${NC}"
        tail -n 12 "$log_file"
    fi
    return 1
}

cmd_stop() {
    echo -e "${BLUE}Stopping Mistbar...${NC}"
    if ags list 2>/dev/null | grep -q "$INSTANCE_NAME"; then
        ags quit -i "$INSTANCE_NAME" 2>/dev/null || true
        sleep 0.3
    fi

    # Force kill any remaining ags run process for this directory
    pkill -f "ags run -d $SRC_DIR" 2>/dev/null || true
    echo -e "${GREEN}✓ Mistbar stopped.${NC}"
}

cmd_restart() {
    cmd_stop
    sleep 0.5
    cmd_start "$@"
}

cmd_toggle() {
    if ! ags list 2>/dev/null | grep -q "$INSTANCE_NAME"; then
        echo -e "${DIM}Mistbar is not running. Starting...${NC}"
        cmd_start
        return
    fi
    local res
    res="$(ags request -i "$INSTANCE_NAME" "toggle" 2>/dev/null || echo "toggled")"
    echo -e "${GREEN}✓ Mistbar is now ${res}.${NC}"
}

cmd_show() {
    if ! ags list 2>/dev/null | grep -q "$INSTANCE_NAME"; then
        cmd_start
        return
    fi
    local res
    res="$(ags request -i "$INSTANCE_NAME" "show" 2>/dev/null || echo "shown (always visible)")"
    echo -e "${GREEN}✓ Mistbar $res.${NC}"
}

cmd_hide() {
    if ags list 2>/dev/null | grep -q "$INSTANCE_NAME"; then
        local res
        res="$(ags request -i "$INSTANCE_NAME" "hide" 2>/dev/null || echo "hidden completely (disabled cursor toggles)")"
        echo -e "${GREEN}✓ Mistbar $res.${NC}"
    fi
}

cmd_autohide() {
    local target="${1:-toggle}"
    if [ "$target" = "on" ] || [ "$target" = "true" ] || [ "$target" = "enable" ]; then
        target="on"
        update_config_json "autoHide" "true"
    elif [ "$target" = "off" ] || [ "$target" = "false" ] || [ "$target" = "disable" ]; then
        target="off"
        update_config_json "autoHide" "false"
    elif [ "$target" = "toggle" ]; then
        target="toggle"
    else
        echo -e "${RED}Usage: mistbar auto-hide <on|off|toggle>${NC}"
        return 1
    fi

    if ags list 2>/dev/null | grep -q "$INSTANCE_NAME"; then
        local res
        res="$(ags request -i "$INSTANCE_NAME" "autohide:$target" 2>/dev/null || echo "autohide updated")"
        echo -e "${GREEN}✓ $res${NC}"
    else
        echo -e "${GREEN}✓ Auto-hide setting saved as: $target${NC}"
    fi
}

cmd_theme() {
    local target="${1:-}"
    if [ "$target" != "dark" ] && [ "$target" != "light" ]; then
        echo -e "${RED}Usage: mistbar theme <dark|light>${NC}"
        return 1
    fi

    update_config_json "theme" "$target"

    if ags list 2>/dev/null | grep -q "$INSTANCE_NAME"; then
        ags request -i "$INSTANCE_NAME" "theme:$target" 2>/dev/null || true
        echo -e "${GREEN}✓ Switched theme to: $target${NC}"
    else
        echo -e "${GREEN}✓ Default theme saved as: $target${NC}"
    fi
}

cmd_style() {
    local target="${1:-}"
    local subvariant="${2:-}"

    if [ "$target" != "glassy" ] && [ "$target" != "transparent" ] && [ "$target" != "solid" ]; then
        echo -e "${RED}Usage: mistbar style <glassy [dark|white]|transparent|solid>${NC}"
        return 1
    fi

    if [ "$target" = "glassy" ] && [ -n "$subvariant" ]; then
        if [ "$subvariant" = "dark" ] || [ "$subvariant" = "black" ]; then
            subvariant="dark"
        elif [ "$subvariant" = "white" ] || [ "$subvariant" = "light" ]; then
            subvariant="white"
        else
            echo -e "${RED}Usage: mistbar style glassy <dark|white>${NC}"
            return 1
        fi
        update_config_json "glassyTextColor" "$subvariant"
    fi

    update_config_json "style" "$target"

    local req="style:$target"
    if [ "$target" = "glassy" ] && [ -n "$subvariant" ]; then
        req="style:$target:$subvariant"
    fi

    if ags list 2>/dev/null | grep -q "$INSTANCE_NAME"; then
        ags request -i "$INSTANCE_NAME" "$req" 2>/dev/null || true
        if [ -n "$subvariant" ]; then
            echo -e "${GREEN}✓ Switched style to: $target ($subvariant fonts & logos)${NC}"
        else
            echo -e "${GREEN}✓ Switched style to: $target${NC}"
        fi
    else
        if [ -n "$subvariant" ]; then
            echo -e "${GREEN}✓ Default style saved as: $target ($subvariant fonts & logos)${NC}"
        else
            echo -e "${GREEN}✓ Default style saved as: $target${NC}"
        fi
    fi
}

cmd_look() {
    local target="${1:-}"
    if [ "$target" != "pill" ] && [ "$target" != "attached" ]; then
        echo -e "${RED}Usage: mistbar look <pill|attached>${NC}"
        return 1
    fi

    update_config_json "look" "$target"

    if ags list 2>/dev/null | grep -q "$INSTANCE_NAME"; then
        ags request -i "$INSTANCE_NAME" "look:$target" 2>/dev/null || true
        echo -e "${GREEN}✓ Switched look to: $target${NC}"
    else
        echo -e "${GREEN}✓ Default look saved as: $target${NC}"
    fi
}

cmd_config() {
    if [ ! -f "$CONFIG_FILE" ]; then
        echo -e "${BLUE}Generating default config at $CONFIG_FILE...${NC}"
        mkdir -p "$CONFIG_DIR"
        cat << 'EOF' > "$CONFIG_FILE"
{
  "theme": "dark",
  "style": "glassy",
  "look": "pill",
  "autoHide": false,
  "barHeight": 28,
  "barMargin": 6,
  "borderRadius": 16,
  "showAppMenu": true,
  "showWorkspaces": true,
  "showTray": true,
  "showBattery": true,
  "showBrightness": true,
  "showVolume": true,
  "showNetwork": true,
  "showBluetooth": true,
  "showControlCenter": true,
  "showSpotlight": true
}
EOF
    fi

    if [ -n "${EDITOR:-}" ]; then
        "$EDITOR" "$CONFIG_FILE"
    else
        cat "$CONFIG_FILE"
        echo ""
        echo -e "${DIM}Config file: $CONFIG_FILE${NC}"
    fi
}

cmd_status() {
    if ags list 2>/dev/null | grep -q "$INSTANCE_NAME"; then
        local state
        state="$(ags request -i "$INSTANCE_NAME" "status" 2>/dev/null || echo "running")"
        echo -e "${GREEN}● Mistbar is ${state}${NC}"
    else
        echo -e "${RED}○ Mistbar is not running${NC}"
    fi
}

cmd_inspect() {
    echo -e "${BLUE}Opening GTK Inspector...${NC}"
    ags inspect -i "$INSTANCE_NAME" 2>/dev/null || echo -e "${RED}Mistbar is not running.${NC}"
}

cmd_install_deps() {
    echo -e "${CYAN}Installing dependencies...${NC}"
    echo ""

    if command -v pacman &>/dev/null; then
        echo -e "${BLUE}Detected Arch-based system (pacman)${NC}"
        echo "Installing: inter-font brightnessctl networkmanager bluez-utils wireplumber gtk4-layer-shell"
        sudo pacman -S --needed --noconfirm \
            inter-font \
            brightnessctl \
            networkmanager \
            bluez-utils \
            wireplumber \
            gtk4-layer-shell \
            2>/dev/null || true
        echo -e "${GREEN}✓ Dependencies installed!${NC}"
    else
        echo -e "${RED}Unsupported package manager. Please install dependencies manually.${NC}"
        echo "Required: inter-font, brightnessctl, networkmanager, bluez-utils, wireplumber, gtk4-layer-shell"
    fi
}

cmd_update() {
    local install_script=""
    if [ -f "$SCRIPT_DIR/install.sh" ]; then
        install_script="$SCRIPT_DIR/install.sh"
    elif [ -f "$HOME/.mistbar/install.sh" ]; then
        install_script="$HOME/.mistbar/install.sh"
    fi

    if [ -n "$install_script" ]; then
        exec bash "$install_script" "$@"
    else
        echo -e "${BLUE}Fetching latest Mistbar installer...${NC}"
        bash -c "$(curl -fsSL https://raw.githubusercontent.com/AbsolOrg/Mistbar/main/install.sh)" -- "$@"
    fi
}

cmd_uninstall() {
    local uninstall_script=""
    if [ -f "$SCRIPT_DIR/uninstall.sh" ]; then
        uninstall_script="$SCRIPT_DIR/uninstall.sh"
    elif [ -f "$HOME/.mistbar/uninstall.sh" ]; then
        uninstall_script="$HOME/.mistbar/uninstall.sh"
    fi

    if [ -n "$uninstall_script" ]; then
        exec bash "$uninstall_script" "$@"
    else
        echo -e "${RED}Error: Uninstall script not found.${NC}"
        exit 1
    fi
}

# ── Main ──
case "${1:-}" in
    start)
        shift
        cmd_start "$@"
        ;;
    stop)
        cmd_stop
        ;;
    restart)
        shift
        cmd_restart "$@"
        ;;
    toggle)
        cmd_toggle
        ;;
    show)
        cmd_show
        ;;
    hide)
        cmd_hide
        ;;
    --auto-hide|autohide|auto-hide)
        shift || true
        cmd_autohide "${1:-toggle}"
        ;;
    --always-visible)
        cmd_autohide "off"
        ;;
    theme)
        shift
        cmd_theme "$@"
        ;;
    style)
        shift
        cmd_style "$@"
        ;;
    look)
        shift
        cmd_look "$@"
        ;;
    config)
        cmd_config
        ;;
    status)
        cmd_status
        ;;
    update)
        shift
        cmd_update "$@"
        ;;
    uninstall)
        shift
        cmd_uninstall "$@"
        ;;
    inspect)
        cmd_inspect
        ;;
    install-deps)
        cmd_install_deps
        ;;
    -v|--version)
        echo "Mistbar v0.2.0"
        ;;
    -h|--help|"")
        print_help
        ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}"
        echo "Run 'mistbar --help' for usage."
        exit 1
        ;;
esac
