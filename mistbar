#!/usr/bin/env bash
# ============================================================================
# Mistbar — macOS Tahoe Liquid Glass Top Bar for Linux (Wayland)
# CLI launcher and manager
# ============================================================================

set -euo pipefail

SCRIPT_SOURCE="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"
SRC_DIR="$SCRIPT_DIR/src"
INSTANCE_NAME="mistbar"
CONFIG_DIR="$HOME/.config/mistbar"
CONFIG_FILE="$CONFIG_DIR/config.json"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m' # No Color

print_banner() {
    echo -e "${CYAN}${BOLD}"
    echo "  ========================================"
    echo "              Mistbar v0.2.0              "
    echo "       macOS Tahoe Liquid Glass Bar       "
    echo "  ========================================"
    echo -e "${NC}"
}

print_help() {
    print_banner
    echo -e "${BOLD}USAGE:${NC}"
    echo "    mistbar <command> [options]"
    echo ""
    echo -e "${BOLD}COMMANDS:${NC}"
    echo -e "    ${GREEN}start${NC}            Start the bar"
    echo -e "    ${GREEN}stop${NC}             Stop the bar"
    echo -e "    ${GREEN}restart${NC}          Restart the bar"
    echo -e "    ${GREEN}toggle${NC}           Toggle bar visibility on/off"
    echo -e "    ${GREEN}show${NC}             Show the bar"
    echo -e "    ${GREEN}hide${NC}             Hide the bar"
    echo -e "    ${GREEN}theme <dark|light>${NC} Switch theme dynamically"
    echo -e "    ${GREEN}status${NC}           Check if the bar is running"
    echo -e "    ${GREEN}config${NC}           View or edit configuration"
    echo -e "    ${GREEN}inspect${NC}          Open GTK Inspector for live debugging"
    echo -e "    ${GREEN}install-deps${NC}     Install required system dependencies"
    echo ""
    echo -e "${BOLD}OPTIONS:${NC}"
    echo -e "    ${BLUE}--auto-hide${NC}      Start with auto-hide behavior"
    echo -e "    ${BLUE}--always-visible${NC}   Start with always-visible behavior (default)"
    echo -e "    ${BLUE}-h, --help${NC}       Show this help message"
    echo -e "    ${BLUE}-v, --version${NC}    Show version"
    echo ""
    echo -e "${BOLD}EXAMPLES:${NC}"
    echo "    mistbar start"
    echo "    mistbar toggle"
    echo "    mistbar theme light"
    echo "    mistbar theme dark"
    echo "    mistbar restart"
    echo "    mistbar stop"
    echo ""
    echo -e "${DIM}Project: https://github.com/AbsolOrg/Mistbar${NC}"
}

check_deps() {
    local missing=()

    command -v ags &>/dev/null || missing+=("ags (AGS 3)")
    command -v niri &>/dev/null || missing+=("niri")
    command -v fuzzel &>/dev/null || missing+=("fuzzel")
    command -v wpctl &>/dev/null || missing+=("wireplumber (wpctl)")
    command -v nmcli &>/dev/null || missing+=("networkmanager (nmcli)")
    command -v bluetoothctl &>/dev/null || missing+=("bluez-utils (bluetoothctl)")
    command -v brightnessctl &>/dev/null || missing+=("brightnessctl")

    if [ ${#missing[@]} -gt 0 ]; then
        echo -e "${RED}Missing dependencies:${NC}"
        for dep in "${missing[@]}"; do
            echo -e "  ✗ $dep"
        done
        echo ""
        echo -e "Run ${CYAN}mistbar install-deps${NC} to install them."
        return 1
    fi
    return 0
}

cmd_start() {
    echo -e "${GREEN}Starting Mistbar...${NC}"

    # Check if already running
    if ags list 2>/dev/null | grep -q "$INSTANCE_NAME"; then
        echo -e "${BLUE}Mistbar is already running. Use 'mistbar restart' to restart.${NC}"
        return 0
    fi

    # Check dependencies
    if ! check_deps; then
        return 1
    fi

    # Handle auto-hide flag if passed
    for arg in "$@"; do
        if [ "$arg" = "--auto-hide" ]; then
            mkdir -p "$CONFIG_DIR"
            if [ -f "$CONFIG_FILE" ]; then
                sed -i 's/"autoHide": false/"autoHide": true/' "$CONFIG_FILE" 2>/dev/null || true
            fi
        elif [ "$arg" = "--always-visible" ]; then
            mkdir -p "$CONFIG_DIR"
            if [ -f "$CONFIG_FILE" ]; then
                sed -i 's/"autoHide": true/"autoHide": false/' "$CONFIG_FILE" 2>/dev/null || true
            fi
        fi
    done

    # Start AGS in background
    if command -v setsid &>/dev/null; then
        setsid -f ags run -d "$SRC_DIR" >/dev/null 2>&1
    else
        nohup ags run -d "$SRC_DIR" >/dev/null 2>&1 &
        disown 2>/dev/null || true
    fi

    sleep 1
    if ags list 2>/dev/null | grep -q "$INSTANCE_NAME"; then
        echo -e "${GREEN}✓ Mistbar started successfully!${NC}"
    else
        echo -e "${RED}✗ Failed to start Mistbar. Check logs.${NC}"
        return 1
    fi
}

cmd_stop() {
    echo -e "${BLUE}Stopping Mistbar...${NC}"

    if ags quit -i "$INSTANCE_NAME" 2>/dev/null; then
        echo -e "${GREEN}✓ Mistbar stopped.${NC}"
    else
        echo -e "${DIM}Mistbar is not running.${NC}"
    fi
}

cmd_restart() {
    cmd_stop 2>/dev/null || true
    sleep 0.5
    cmd_start "$@"
}

cmd_toggle() {
    if ! ags list 2>/dev/null | grep -q "$INSTANCE_NAME"; then
        echo -e "${DIM}Mistbar is not running. Starting...${NC}"
        cmd_start
        return
    fi
    ags request -i "$INSTANCE_NAME" "toggle" 2>/dev/null || echo -e "${RED}Failed to send toggle command.${NC}"
}

cmd_show() {
    if ! ags list 2>/dev/null | grep -q "$INSTANCE_NAME"; then
        cmd_start
        return
    fi
    ags request -i "$INSTANCE_NAME" "show" 2>/dev/null || true
}

cmd_hide() {
    if ags list 2>/dev/null | grep -q "$INSTANCE_NAME"; then
        ags request -i "$INSTANCE_NAME" "hide" 2>/dev/null || true
    fi
}

cmd_theme() {
    local target="${1:-}"
    if [ "$target" != "dark" ] && [ "$target" != "light" ]; then
        echo -e "${RED}Usage: mistbar theme <dark|light>${NC}"
        return 1
    fi

    # Update config file
    mkdir -p "$CONFIG_DIR"
    if [ -f "$CONFIG_FILE" ]; then
        sed -i "s/\"theme\": \"[^\"]*\"/\"theme\": \"$target\"/" "$CONFIG_FILE" 2>/dev/null || true
    fi

    # If running, send dynamic IPC request
    if ags list 2>/dev/null | grep -q "$INSTANCE_NAME"; then
        ags request -i "$INSTANCE_NAME" "theme:$target" 2>/dev/null || true
        echo -e "${GREEN}✓ Switched theme to: $target${NC}"
    else
        echo -e "${GREEN}✓ Default theme saved as: $target${NC}"
    fi
}

cmd_config() {
    if [ ! -f "$CONFIG_FILE" ]; then
        echo -e "${BLUE}Generating default config at $CONFIG_FILE...${NC}"
        mkdir -p "$CONFIG_DIR"
        cat << 'EOF' > "$CONFIG_FILE"
{
  "theme": "dark",
  "autoHide": false,
  "barHeight": 28,
  "barMargin": 6,
  "borderRadius": 14,
  "showAppMenu": true,
  "showWorkspaces": true,
  "showTray": true,
  "showBattery": true,
  "showBrightness": true,
  "showVolume": true,
  "showNetwork": true,
  "showBluetooth": true,
  "showControlCenter": true
}
EOF
    fi

    if [ -n "${EDITOR:-}" ]; then
        "$EDITOR" "$CONFIG_FILE"
    else
        cat "$CONFIG_FILE"
        echo ""
        echo -e "${DIM}Config file: $CONFIG_FILE${NC}"
    fi
}

cmd_status() {
    if ags list 2>/dev/null | grep -q "$INSTANCE_NAME"; then
        local state
        state="$(ags request -i "$INSTANCE_NAME" "status" 2>/dev/null || echo "running")"
        echo -e "${GREEN}● Mistbar is ${state}${NC}"
    else
        echo -e "${RED}○ Mistbar is not running${NC}"
    fi
}

cmd_inspect() {
    echo -e "${BLUE}Opening GTK Inspector...${NC}"
    ags inspect -i "$INSTANCE_NAME" 2>/dev/null || echo -e "${RED}Mistbar is not running.${NC}"
}

cmd_install_deps() {
    echo -e "${CYAN}Installing dependencies...${NC}"
    echo ""

    if command -v pacman &>/dev/null; then
        echo -e "${BLUE}Detected Arch-based system (pacman)${NC}"
        echo "Installing: inter-font brightnessctl networkmanager bluez-utils wireplumber gtk4-layer-shell"
        sudo pacman -S --needed --noconfirm \
            inter-font \
            brightnessctl \
            networkmanager \
            bluez-utils \
            wireplumber \
            gtk4-layer-shell \
            2>/dev/null || true
        echo -e "${GREEN}✓ Dependencies installed!${NC}"
    else
        echo -e "${RED}Unsupported package manager. Please install dependencies manually.${NC}"
        echo "Required: inter-font, brightnessctl, networkmanager, bluez-utils, wireplumber, gtk4-layer-shell"
    fi
}

# ── Main ──
case "${1:-}" in
    start)
        shift
        cmd_start "$@"
        ;;
    stop)
        cmd_stop
        ;;
    restart)
        shift
        cmd_restart "$@"
        ;;
    toggle)
        cmd_toggle
        ;;
    show)
        cmd_show
        ;;
    hide)
        cmd_hide
        ;;
    theme)
        shift
        cmd_theme "$@"
        ;;
    config)
        cmd_config
        ;;
    status)
        cmd_status
        ;;
    inspect)
        cmd_inspect
        ;;
    install-deps)
        cmd_install_deps
        ;;
    -v|--version)
        echo "Mistbar v0.2.0"
        ;;
    -h|--help|"")
        print_help
        ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}"
        echo "Run 'mistbar --help' for usage."
        exit 1
        ;;
esac
